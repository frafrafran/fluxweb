/**
 * Configuración del Worker de Cloudflare que sirve el sitio.
 * El build lo genera @opennextjs/cloudflare en `.open-next/`:
 *   npm run preview   -> build + vista previa local con el runtime de Workers
 *   npm run deploy    -> build + publicación
 * Con el repositorio conectado en el panel de Cloudflare, cada push a `main`
 * corre esos mismos comandos.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fluxweb",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "fluxweb"
    }
  ],
  /* Optimización de next/image con Cloudflare Images. */
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  /* Variables de ejecución. Las secretas (RESEND_API_KEY, CONTACT_FROM_EMAIL)
     se cargan con `wrangler secret put` o desde el panel, nunca acá.
     NEXT_PUBLIC_SITE_URL se usa en el BUILD, no acá: con dominio propio va en
     las variables de build del panel de Cloudflare. */
  "vars": {}
}
